# ===== 大模型（OpenAI 兼容接口）=====
# base URL 到 /v1 为止，例如：
#   DeepSeek : https://api.deepseek.com/v1
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi     : https://api.moonshot.cn/v1
#   智谱     : https://open.bigmodel.cn/api/paas/v4
#   OpenAI   : https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=deepseek-v4-flash

# ===== 联网搜索（Tavily）=====
# 申请：https://tavily.com  未填则自动关闭联网搜索能力
TAVILY_API_KEY=

# ===== 服务 =====
# 注意：改 PORT 的话，vite.config.js 里 dev 代理的目标端口要一起改，
# 否则 npm run dev:web 的 /api 请求会全部打空
PORT=3001
HOST=127.0.0.1

# ===== 登录 =====
# 是否开放注册入口。默认 true；设为 false 后登录界面不再显示「注册」，
# 已有账号仍可正常登录（适合首个账号建好后关掉）
ALLOW_REGISTER=true

# ===== 记忆参数 =====
# 短期记忆：注入的最近消息条数
SHORT_TERM_MESSAGES=20
# 长期记忆（摘要式，复用对话模型，无需 embedding）：默认开启，设为 false 关闭
ENABLE_LONG_TERM=true
